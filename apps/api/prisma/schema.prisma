datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  EDITOR
  REVIEWER
  ADMIN
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  CORRECTION
  ARCHIVED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model User {
  id             String            @id @default(uuid())
  guestId        String?           @unique
  firebaseUid    String?           @unique
  phoneNumber    String?           @unique
  email          String?           @unique
  fullName       String?
  passwordHash   String?
  role           Role              @default(STUDENT)
  selectedClass  String            @default("SSC")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sessions       ExamSession[]
  mistakes       RevisionMistake[]
  reviews        ContentReview[]
  events         EventLog[]
  bookmarks      StudentBookmark[]
  notes          StudentNote[]
  contentReports ContentReport[]
  studyPlanTasks StudyPlanTask[]
  rehearsals     MultiExamRehearsal[]
  guardianShareLinks GuardianShareLink[]
}

model MultiExamRehearsal {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  titleBangla       String
  program           String    @default("SSC")
  papers            Json
  currentPaperIndex Int       @default(0)
  status            String    @default("IN_PROGRESS")
  totalScore        Float?
  totalMarks        Int       @default(0)
  startedAt         DateTime  @default(now())
  submittedAt       DateTime?

  @@index([userId, startedAt])
}

model GuardianShareLink {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  shareCode      String    @unique
  audience       String    @default("PARENT")
  recipientLabel String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  lastViewedAt   DateTime?

  @@index([userId, isActive])
}

model Subject {
  id           String    @id @default(uuid())
  code         String    @unique // e.g. "ssc_physics"
  nameBangla   String    // "পদার্থবিজ্ঞান"
  classLevel   String    // "CLASS_9_10"
  program      String    @default("SSC")
  syllabusYear Int       @default(2026)
  isReady      Boolean   @default(false)
  chapters     Chapter[]

  @@index([program, isReady])
}

model Chapter {
  id          String   @id @default(uuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  orderIndex  Int
  titleBangla String   // e.g. "বল (Force)"
  topics      Topic[]

  @@unique([subjectId, orderIndex])
  @@index([subjectId])
}

model Topic {
  id          String     @id @default(uuid())
  chapterId   String
  chapter     Chapter    @relation(fields: [chapterId], references: [id])
  orderIndex  Int
  titleBangla String     // e.g. "নিউটনের গতির সূত্র"
  lessons     Lesson[]
  questions   Question[]

  @@unique([chapterId, orderIndex])
  @@index([chapterId])
}

model Lesson {
  id                   String        @id @default(uuid())
  topicId              String
  topic                Topic         @relation(fields: [topicId], references: [id])
  titleBangla          String
  learningGoal         String
  explanation          String        // Formatted Markdown with KaTeX math & inline media tags
  interactiveWidgetUrl String?       // Optional URL to sandboxed HTML simulation
  audioUrl             String?
  audioDurationSeconds Int?
  importantTerms       Json          // Array of { termBangla, termEnglish, definition }
  workedExample        Json?         // { problem, stepByStepSolution }
  memoryAid            String?       // Mnemonics or high-yield summary
  status               ContentStatus @default(DRAFT)
  version              Int           @default(1)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([topicId, status])
  @@index([status, updatedAt])
}

model Question {
  id          String            @id @default(uuid())
  topicId     String
  topic       Topic             @relation(fields: [topicId], references: [id])
  type        String            @default("MCQ") // MCQ | CQ_CREATIVE
  stem        String            // Bengali stem with KaTeX LaTeX
  options     Json?             // Array of { id, text, isCorrect }
  explanation Json              // ExplanationObject with 6 layers
  cqRubric    Json?             // Rubric for ক, খ, গ, ঘ
  difficulty  String            @default("MEDIUM")
  boardSource String?           // e.g. "Dhaka Board 2024"
  isVerified  Boolean           @default(false)
  status      ContentStatus     @default(DRAFT)
  version     Int               @default(1)
  mistakes    RevisionMistake[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([topicId, status])
  @@index([status, updatedAt])
}

model ExamSession {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  testType        String    // "CHAPTER_TEST" | "TOPIC_TEST"
  subjectId       String
  chapterId       String?
  totalQuestions  Int
  durationSeconds Int
  negativeRatio   Float     @default(0.0)
  score           Float     @default(0.0)
  answers         Json      // Array of { questionId, selectedOption, isCorrect, timeSpent }
  status          String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ABANDONED
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([userId, status])
}

model RevisionMistake {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptCount Int      @default(1)
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, questionId])
}

model ContentReview {
  id          String   @id @default(uuid())
  contentType String   // "LESSON" | "QUESTION"
  contentId   String
  reviewerId  String
  reviewer    User     @relation(fields: [reviewerId], references: [id])
  action      String   // "APPROVE" | "REJECT" | "REQUEST_CHANGES"
  comment     String?
  version     Int
  createdAt   DateTime @default(now())

  @@index([contentType, contentId])
  @@index([reviewerId])
}

model EventLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String   // "LESSON_OPEN" | "PRACTICE_ATTEMPT" | "TEST_SUBMIT"
  payload   Json
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
}

model StudentBookmark {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId         String
  itemType       String   // "topic" | "question"
  titleBangla    String
  subtitleBangla String?
  href           String
  createdAt      DateTime @default(now())

  @@unique([userId, itemId, itemType])
  @@index([userId, createdAt])
}

model StudentNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, topicId])
  @@index([userId, updatedAt])
}

model ContentReport {
  id             String       @id @default(uuid())
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  contentType    String       // "LESSON" | "QUESTION"
  contentId      String
  topicId        String?
  category       String       // "WRONG_ANSWER" | "TYPO_OR_LATEX" | "UNCLEAR_EXPLANATION" | "CURRICULUM_MISMATCH" | "OTHER"
  description    String
  status         ReportStatus @default(OPEN)
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([contentType, contentId])
  @@index([userId, createdAt])
}

model StudyPlanTask {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId     String?
  chapterId     String?
  topicId       String?
  titleBangla   String
  scheduledDate String    // "YYYY-MM-DD"
  reminderTime  String?   // "HH:mm"
  targetType    String    @default("CUSTOM") // "LESSON" | "PRACTICE" | "MODEL_TEST" | "REVISION" | "CUSTOM"
  completed     Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, scheduledDate])
}
